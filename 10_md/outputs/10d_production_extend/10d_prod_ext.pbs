#!/bin/bash
#PBS -N cm10d_prodext
#PBS -l select=1:ncpus=8:ngpus=1:mem=16gb
#PBS -l walltime=168:00:00
#PBS -m ae
#PBS -M 18660916@sun.ac.za
#PBS -j oe
#PBS -o /home/18660916/system_development/04_amber_md/10d_production_extend/10d_prod_ext.pbs.out

set -uo pipefail
echo "host=$(hostname)  jobid=${PBS_JOBID:-UNSET}  start=$(date)"
nvidia-smi -L 2>/dev/null || { echo "FAIL no GPU visible"; exit 1; }

# choose a scratch dir with >= 55 GB free (the 40 ns trajectory is ~26 GB and the
# restart and output add to it); fail fast if none
need_kb=57671680
scratch=""
for base in /scratch-small-local /scratch-large-network; do
  d="$base/${PBS_JOBID}"
  mkdir -p "$d" 2>/dev/null || continue
  avail=$(df -Pk "$d" 2>/dev/null | awk 'END{print $4}')
  if [[ "${avail:-0}" -ge "$need_kb" ]]; then scratch="$d"; echo "scratch=$scratch (avail ${avail} KB)"; break; fi
  rmdir "$d" 2>/dev/null || true
done
[[ -n "$scratch" ]] || { echo "FAIL no scratch dir with >=55GB free for the trajectory"; exit 1; }
# clean our own scratch on ANY exit (normal end, qdel, or walltime kill)
trap 'cd "/home/18660916/system_development/04_amber_md/10d_production_extend" 2>/dev/null; rm -rf "$scratch" 2>/dev/null' EXIT TERM

cp "/home/18660916/system_development/04_amber_md/10d_production_extend/prod_ext.in" "/home/18660916/system_development/03_amber/tleap_build/complex_solvated.prmtop" "/home/18660916/system_development/04_amber_md/10c_production/prod.rst7" "$scratch"/
cd "$scratch"

set +u
export PERL5LIB="${PERL5LIB:-}" PYTHONPATH="${PYTHONPATH:-}"
module load app/amber22/22
set -u
command -v pmemd.cuda >/dev/null || { echo "FAIL pmemd.cuda not found"; exit 1; }
[[ -e "/apps/mambaforge/pkgs/cudatoolkit-11.8.0-h37601d7_11/lib/libcufft.so.10" ]]   || { echo "FAIL CUDA libs missing at /apps/mambaforge/pkgs/cudatoolkit-11.8.0-h37601d7_11/lib"; exit 1; }
[[ -e "/apps/mambaforge/envs/medaka/lib/libopenblas.so.0" ]] || { echo "FAIL openblas missing at /apps/mambaforge/envs/medaka/lib"; exit 1; }
export LD_LIBRARY_PATH="/apps/mambaforge/pkgs/cudatoolkit-11.8.0-h37601d7_11/lib:/apps/mambaforge/envs/medaka/lib:${LD_LIBRARY_PATH:-}"

echo "=== running 40 ns production extension (pmemd.cuda) ==="
pmemd.cuda -O -i prod_ext.in -o prod_ext.out -p "complex_solvated.prmtop" -c "prod.rst7" \
  -r prod_ext.rst7 -x prod_ext.nc -inf prod_ext.mdinfo
rc=$?

echo "=== copying results to $HOME (1 TB tier) ==="
cp -f prod_ext.out prod_ext.mdinfo "/home/18660916/system_development/04_amber_md/10d_production_extend"/ 2>/dev/null || true
if [[ $rc -eq 0 ]]; then
  cp -f prod_ext.rst7 prod_ext.nc "/home/18660916/system_development/04_amber_md/10d_production_extend"/ 2>/dev/null || true
fi

[[ $rc -eq 0 ]] || { echo "FAIL pmemd.cuda rc=$rc"; tail -30 "/home/18660916/system_development/04_amber_md/10d_production_extend/prod_ext.out" 2>/dev/null; exit 1; }
[[ -s "/home/18660916/system_development/04_amber_md/10d_production_extend/prod_ext.nc" && -s "/home/18660916/system_development/04_amber_md/10d_production_extend/prod_ext.rst7" ]] || { echo "FAIL missing trajectory or restart"; exit 1; }
echo "=== summary ==="
grep -E "ns/day|TIME\(PS\) =|Density" "/home/18660916/system_development/04_amber_md/10d_production_extend/prod_ext.out" | tail -5 || true
ls -lh "/home/18660916/system_development/04_amber_md/10d_production_extend/prod_ext.nc" "/home/18660916/system_development/04_amber_md/10d_production_extend/prod_ext.rst7"
echo "end=$(date)"
echo "FINAL PASS: 10d production extension complete (trajectory prod_ext.nc, restart prod_ext.rst7)"
echo
echo "The extension continues 10c, so the two are one trajectory: prod.nc then"
echo "prod_ext.nc, 60 ns total, of which the first 10 ns are pre-equilibration."
